{
    "name": "sugarcommerce/geo",
    "description": "Countries for a WordPress shop: names and codes, states and provinces, EU membership, continents, flags, and addresses written the way each country writes them.",
    "type": "library",
    "license": "GPL-3.0-or-later",
    "homepage": "https://github.com/sugarcommerce/geo",
    "authors": [
        {
            "name": "David Sherlock",
            "homepage": "https://arraypress.com/"
        }
    ],
    "require": {
        "php": ">=8.3",
        "ext-mbstring": "*"
    },
    "autoload": {
        "psr-4": {
            "SugarCommerce\\Geo\\": "src/"
        }
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "support": {
        "issues": "https://github.com/sugarcommerce/geo/issues",
        "source": "https://github.com/sugarcommerce/geo"
    },
    "keywords": [
        "wordpress",
        "countries",
        "iso-3166",
        "regions",
        "states",
        "eu",
        "vat",
        "addresses",
        "address-format",
        "flags"
    ],
    "require-dev": {
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "phpunit/phpunit": "^12.0",
        "squizlabs/php_codesniffer": "^3.13.5",
        "wp-coding-standards/wpcs": "^3.4"
    },
    "autoload-dev": {
        "psr-4": {
            "SugarCommerce\\Geo\\Tests\\": "tests/"
        },
        "exclude-from-classmap": [
            "/tests/bootstrap.php"
        ]
    },
    "scripts": {
        "test": "phpunit",
        "lint": "phpcs",
        "format": "phpcbf --standard=phpcs-format.xml.dist",
        "format:check": "phpcs --standard=phpcs-format.xml.dist"
    }
}
